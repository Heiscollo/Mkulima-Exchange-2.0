    {
      "name": "Listings",
      "item": [
        {
          "name": "Create Listing",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "crop_name", "value": "Tomatoes", "type": "text" },
                { "key": "crop_category", "value": "VEGETABLES", "type": "text" },
                { "key": "quantity", "value": "120", "type": "text" },
                { "key": "unit", "value": "KG", "type": "text" },
                { "key": "price_per_unit", "value": "45", "type": "text" },
                { "key": "county", "value": "NAKURU", "type": "text" },
                { "key": "available_date", "value": "2026-07-15", "type": "text" },
                { "key": "minimum_order_quantity", "value": "10", "type": "text" },
                { "key": "description", "value": "Fresh greenhouse tomatoes", "type": "text" },
                { "key": "images", "type": "file", "src": ["/path/to/listing-image-1.jpg"] }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/listings",
              "host": ["{{baseUrl}}"],
              "path": ["api", "listings"]
            }
          }
        },
        {
          "name": "Get All Listings",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/listings",
              "host": ["{{baseUrl}}"],
              "path": ["api", "listings"]
